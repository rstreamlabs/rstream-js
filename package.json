{
  "name": "rstream-repo",
  "homepage": "https://github.com/rstreamlabs/rstream-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstreamlabs/rstream-js.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/rstreamlabs/rstream-js/issues"
  },
  "private": true,
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "ci:release": "changeset publish",
    "ci:version": "changeset version",
    "clean": "turbo clean",
    "dev": "turbo watch dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo lint",
    "test": "node --test test/*.test.mjs && turbo test --concurrency=1",
    "type-check": "turbo type-check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "tsup": {
      "esbuild": "$esbuild"
    }
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
