{
  "name": "@rstreamlabs/utils",
  "version": "1.7.1",
  "description": "Shared utility functions used across rstream packages and applications.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstreamlabs/rstream-js",
    "directory": "packages/utils"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./file-sharing": {
      "types": "./dist/file-sharing.d.ts",
      "import": "./dist/file-sharing.mjs",
      "require": "./dist/file-sharing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:watch": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "eslint \"./**/*.ts*\"",
    "pretest": "npm run build",
    "test": "node --test ./test/**/*.test.cjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.6",
    "@types/node": "^26",
    "eslint": "9.39.5",
    "eslint-config": "*",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "typescript-config": "*"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
