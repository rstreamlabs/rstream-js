{
  "name": "@rstreamlabs/tunnels",
  "version": "3.2.1",
  "description": "JS/TS SDK for the rstream Engine API and tunnel runtime APIs.",
  "author": "@uartnet <hello@rstream.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstreamlabs/rstream-js",
    "directory": "packages/tunnels"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.mjs",
      "require": "./dist/openapi.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:watch": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "eslint \"./**/*.ts*\"",
    "pretest": "npm --prefix ../rstream run build && npm run build",
    "test": "node --test ./test/**/*.test.cjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "^2.9.5",
    "@types/node": "^25",
    "eslint": "9.39.4",
    "eslint-config": "*",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-config": "*"
  },
  "dependencies": {
    "@rstreamlabs/rstream": "3.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
