{
  "name": "@rstreamlabs/react",
  "version": "1.10.8",
  "description": "React hooks and components for building rstream-enabled UIs.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstreamlabs/rstream-js",
    "directory": "packages/react"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.mjs",
      "require": "./dist/providers/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:watch": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "eslint \"./**/*.ts*\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.6",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint-config": "*",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "typescript-config": "*"
  },
  "dependencies": {
    "@rstreamlabs/rstream": "3.8.1",
    "@rstreamlabs/tunnels": "3.8.2",
    "@rstreamlabs/webtty": "1.9.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.0 || ^19.0",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "@types/react": "*",
    "react": "^18.0 || ^19.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
