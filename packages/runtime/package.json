{
  "name": "@rstreamlabs/runtime",
  "version": "0.4.2",
  "description": "Node.js runtime SDK for the rstream tunnel protocol.",
  "author": "@uartnet <hello@rstream.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstreamlabs/rstream-js",
    "directory": "packages/runtime"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "test/e2e/runtime-bytestream.cjs"
  ],
  "scripts": {
    "build:watch": "tsup --watch",
    "build": "npm run generate-proto-files && tsup",
    "clean": "rm -rf .generated && rm -rf dist",
    "generate-proto-files": "bash scripts/generate-proto-files.sh",
    "lint": "eslint \"./**/*.ts*\"",
    "pretest": "npm run build",
    "test": "node --test ./test/**/*.test.cjs",
    "test:e2e": "npm run build && node ./test/e2e/runtime-bytestream.cjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.0",
    "@types/node": "^26",
    "eslint": "9.39.4",
    "eslint-config": "*",
    "protobufjs-cli": "^2.5.6",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-config": "*"
  },
  "dependencies": {
    "@rstreamlabs/rstream": "3.4.0",
    "@rstreamlabs/tunnels": "3.6.0",
    "protobufjs": "^8.6.5",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
