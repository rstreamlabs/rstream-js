    "generate-proto-files": "bash scripts/generate-proto-files.sh",
    "lint": "eslint \"./**/*.ts*\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "^2.4.0",
    "@types/node": "^22",
    "eslint-config": "*",
    "eslint": "9.19.0",
    "protobufjs-cli": "^1.1.3",
    "tsup": "^8.3.6",
    "typescript-config": "*",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "protobufjs": "^7.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
