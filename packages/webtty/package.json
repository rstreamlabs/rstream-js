{
  "name": "@rstreamlabs/webtty",
  "version": "1.9.1",
  "description": "Client-side implementation of the rstream WebTTY protocol.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstreamlabs/rstream-js",
    "directory": "packages/webtty"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build:watch": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf .generated && rm -rf dist",
    "generate-proto-files": "bash scripts/generate-proto-files.sh",
    "lint": "eslint \"./**/*.ts*\"",
    "pretest": "npm run generate-proto-files && npm run build",
    "test": "node --test ./test/**/*.test.cjs",
    "test:runtime": "node ./test/runtime-e2e.mjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.11",
    "@types/node": "^26",
    "eslint": "9.39.5",
    "eslint-config": "*",
    "protobufjs-cli": "^2.6.2",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "typescript-config": "*",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "protobufjs": "^8.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
