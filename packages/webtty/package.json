{
  "name": "@rstreamlabs/webtty",
  "version": "1.6.2",
  "description": "Client-side implementation of the rstream WebTTY protocol.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
