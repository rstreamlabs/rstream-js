{
  "name": "@rstreamlabs/webtty",
  "version": "1.6.5",
  "description": "Client-side implementation of the rstream WebTTY protocol.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstreamlabs/rstream-js",
    "directory": "packages/webtty"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:watch": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf .generated && rm -rf dist",
    "generate-proto-files": "bash scripts/generate-proto-files.sh",
    "lint": "eslint \"./**/*.ts*\"",
    "pretest": "npm run generate-proto-files && npm run build",
    "test": "node --test ./test/**/*.test.cjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "^2.9.5",
    "@types/node": "^25",
    "eslint-config": "*",
    "eslint": "9.39.4",
    "protobufjs-cli": "^2.4.0",
    "tsup": "^8.5.1",
    "typescript-config": "*",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "protobufjs": "^8.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
