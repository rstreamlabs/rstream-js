{
  "name": "@rstreamlabs/rstream",
  "version": "2.1.4",
  "description": "JS/TS SDK for the rstream Control plane API and shared types.",
  "author": "@uartnet <hello@rstream.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rstreamlabs/rstream-js",
    "directory": "packages/rstream"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./auth-token": {
      "types": "./dist/auth-token.d.ts",
      "import": "./dist/auth-token.mjs",
      "require": "./dist/auth-token.js"
    },
    "./tunnel": {
      "types": "./dist/tunnel.d.ts",
      "import": "./dist/tunnel.mjs",
      "require": "./dist/tunnel.js"
    },
    "./tunnels-project": {
      "types": "./dist/tunnels-project.d.ts",
      "import": "./dist/tunnels-project.mjs",
      "require": "./dist/tunnels-project.js"
    },
    "./turn": {
      "types": "./dist/turn.d.ts",
      "import": "./dist/turn.mjs",
      "require": "./dist/turn.js"
    },
    "./whoami": {
      "types": "./dist/whoami.d.ts",
      "import": "./dist/whoami.mjs",
      "require": "./dist/whoami.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.mjs",
      "require": "./dist/zod.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:watch": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "eslint \"./**/*.ts*\"",
    "pretest": "npm run build",
    "test": "node --test ./test/**/*.test.cjs",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@turbo/gen": "^2.9.5",
    "@types/node": "^25",
    "eslint": "9.39.4",
    "eslint-config": "*",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "typescript-config": "*"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
